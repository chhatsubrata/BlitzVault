# BlitzVault — environment setup index (no secrets in this file)
#
# Copy per-app examples and fill in Clerk keys from https://dashboard.clerk.com
#
#   cp backend/.env.example backend/.env.local
#   cp frontend/.env.example frontend/.env.local
#
# Real values belong only in *.env.local (gitignored).

# --- Database (matches docker-compose.dev.yml) ---
# Set these in backend/.env.local:
#   DB_HOST=127.0.0.1
#   DB_PORT=5434
#   DB_USERNAME=postgres
#   DB_PASSWORD=postgres
#   DB_DATABASE=blitz_vault

# --- API (Monday contract) ---
# Backend PORT (backend/.env.local): 5001
# Frontend NEXT_PUBLIC_BACKEND_URL (frontend/.env.local): http://localhost:5001
# API path prefix: /api/v1

# --- Clerk (required in both backend and frontend .env.local) ---
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...  (frontend)
# CLERK_JWT_ISSUER=https://<instance>.clerk.accounts.dev  (backend)

# --- Redis (matches docker-compose.dev.yml; BullMQ workers + rate limit) ---
# Set in backend/.env.local (defaults work for local):
#   REDIS_HOST=127.0.0.1
#   REDIS_PORT=6379
#   REDIS_PASSWORD=

# --- OpenFGA (Phase 2 authorization; matches docker-compose.dev.yml) ---
# Off by default so the app boots without an FGA server (denies by default).
# Turn on: `docker compose -f docker-compose.dev.yml up -d`, then from backend/
# `pnpm fga:init --write-env` — creates the store, pushes src/authz/model.fga,
# and fills the ids into backend/.env.local:
#   FGA_ENABLED=true
#   FGA_API_URL=http://localhost:8080
#   FGA_STORE_ID=<from pnpm fga:init>
#   FGA_MODEL_ID=<from pnpm fga:init — changes on every model write; restart the API>
# See docs/openfga-model.md and docs/sprint-week-3.md

# See docs/contracts-week1-monday.md and docs/sprint-week-1.md
