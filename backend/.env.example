# Required — server exits at boot if missing
# DB defaults match docker-compose.dev.yml
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=blitz_vault
PORT=5001

CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev

# Optional
CLERK_JWT_AUDIENCE=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (defaults match docker-compose.dev.yml; used by BullMQ workers + rate limit)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# AV scan worker (ClamAV/clamd). Off by default — scan stub treats files as
# clean. Set CLAMAV_ENABLED=true and start the `clamav` compose service to wire
# the real daemon (host:port match docker-compose.dev.yml).
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=15000

# OpenFGA authorization (Phase 2). Off by default — the service denies every
# check, so the app boots without a server. To turn on: start compose, then run
# `pnpm fga:init --write-env` — it creates the store, pushes
# src/authz/model.fga, and fills the two ids below. Every model write mints a
# new FGA_MODEL_ID and it is read at boot, so restart the API after a change.
FGA_ENABLED=false
FGA_API_URL=http://localhost:8080
FGA_STORE_ID=
FGA_MODEL_ID=

# Object storage — Cloudinary now (creds from https://cloudinary.com console)
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload limits / idempotency (optional — sane defaults applied)
# MAX_FILE_SIZE_BYTES=5368709120        # 5 GiB
# UPLOAD_IDEMPOTENCY_TTL_SECONDS=86400   # cache /upload/init responses 24h

# Future drivers (set STORAGE_DRIVER=s3|r2, add these — not implemented yet):
# STORAGE_ENDPOINT=
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_FORCE_PATH_STYLE=true
